#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <100>;
            quick-tap-ms = <100>;
        };

        shifthr: shifthr {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFTHR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <185>;
            flavor = "tap-preferred";
            quick-tap-ms = <185>;
        };

        weak: weak {
            compatible = "zmk,behavior-hold-tap";
            label = "WEAK";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <230>;
        };
    };

    combos {
        compatible = "zmk,combos";

        underscore_right {
            bindings = <&kp MINUS>;
            key-positions = <11 10>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <0 1>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <16 19>;
        };

        backlash {
            bindings = <&kp BACKSLASH>;
            key-positions = <23 22>;
        };

        bootloader-right {
            bindings = <&bootloader>;
            key-positions = <11 42>;
        };

        bootloader-left {
            bindings = <&bootloader>;
            key-positions = <0 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&lt 1 ESCAPE        &kp Q                  &lt 3 W                 &kp E           &kp R               &kp T      &kp Y            &kp U                &kp I            &kp O                &kp P                      &mt MINUS BACKSPACE
&mt LEFT_SHIFT TAB  &hm LEFT_SHIFT A       &hm LEFT_COMMAND S      &hm LEFT_ALT D  &hm LEFT_CONTROL F  &kp G      &kp H            &hm RIGHT_CONTROL J  &hm RIGHT_ALT K  &hm RIGHT_COMMAND L  &hm RIGHT_SHIFT SEMICOLON  &mt BACKSLASH ENTER
&kp LEFT_COMMAND    &kp Z                  &kp X                   &kp C           &kp V               &kp B      &kp N            &kp M                &kp COMMA        &kp PERIOD           &kp SLASH                  &kp APOS
&mt LCTRL EQUAL     &mt LALT LEFT_BRACKET  &mt LGUI RIGHT_BRACKET  &kp DELETE      &kp ENTER           &lt 1 TAB  &lt 2 BACKSPACE  &lt 3 SPACE          &kp LEFT_ARROW   &kp UP_ARROW         &kp DOWN                   &kp RIGHT
            >;
        };

        numbers {
            bindings = <
&kp GRAVE  &kp NUMBER_1            &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4             &kp N5       &kp NUMBER_6  &kp N7                  &kp N8          &kp N9                     &kp N0                        &kp EQUAL
&kp TILDE  &hm LSHIFT EXCLAMATION  &hm LGUI AT   &hm LALT HASH  &hm LEFT_CONTROL DOLLAR  &kp PERCENT  &kp CARET     &hm RIGHT_CONTROL AMPS  &hm RALT ASTRK  &hm RGUI LEFT_PARENTHESIS  &hm RSHIFT RIGHT_PARENTHESIS  &kp PLUS
&kp F1     &kp F2                  &kp F3        &kp F4         &kp F5                   &kp F6       &trans        &kp MINUS               &kp PLUS        &kp LEFT_BRACKET           &kp RIGHT_BRACKET             &kp NON_US_BACKSLASH
&kp F7     &kp F8                  &kp F9        &kp F10        &kp F11                  &kp F12      &trans        &trans                  &kp HOME        &kp END                    &kp PAGE_UP                   &kp PAGE_DOWN
            >;
        };

        special {
            bindings = <
&kp LA(LEFT_GUI)  &kp LS(LEFT_GUI)  &kp LG(LS(NUMBER_4))  &kp LG(LC(LS(NUMBER_4)))  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &trans  &trans    &trans       &trans         &bt BT_CLR
&trans            &trans            &trans                &hm LALT C_MUTE           &kp C_VOL_DN          &kp C_VOLUME_UP       &trans  &trans  &trans    &trans       &trans         &trans
&trans            &trans            &trans                &kp C_PREV                &kp C_PLAY            &kp C_NEXT            &trans  &trans  &trans    &trans       &trans         &trans
&bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2          &bt BT_SEL 3              &bt BT_SEL 4          &trans                &trans  &trans  &kp HOME  &kp PAGE_UP  &kp PAGE_DOWN  &kp END
            >;
        };

        calculator {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp N7        &kp N8  &kp N9  &kp PLUS      &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp N4        &kp N5  &kp N6  &kp ASTERISK  &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp N1        &kp N2  &kp N3  &kp PERIOD    &kp COMMA  &trans
&trans  &trans  &trans  &none   &none   &none   &kp NUMBER_0  &none   &trans  &none         &none      &none
            >;
        };
    };
};
